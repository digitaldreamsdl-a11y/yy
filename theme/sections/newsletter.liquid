<section class="section-padding color-scheme-{{ section.settings.color_scheme }}" style="padding-top:{{ section.settings.padding_top }}px; padding-bottom:{{ section.settings.padding_bottom }}px; background: var(--scheme-{{ section.settings.color_scheme }}-bg); color: var(--scheme-{{ section.settings.color_scheme }}-text);">
  <div class="page-width newsletter">
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="h2 mt-2">{{ section.settings.heading }}</h2>
    <p class="rte mt-4" style="margin-inline:auto;">{{ section.settings.text }}</p>

    {%- form 'customer', id: 'NewsletterForm' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div class="newsletter__form">
        <div class="field">
          <label class="visually-hidden" for="NewsletterEmail">Email</label>
          <input type="email" id="NewsletterEmail" name="contact[email]" placeholder="Your email address" required>
        </div>
        <button type="submit" class="btn btn--accent">Subscribe</button>
      </div>
      {%- if form.posted_successfully? -%}
        <p class="field__hint mt-4">Thanks — check your inbox to confirm.</p>
      {%- endif -%}
    {%- endform -%}
    <p class="field__hint mt-4" style="color: var(--scheme-{{ section.settings.color_scheme }}-text-secondary);">No spam — one edit a week, unsubscribe anytime.</p>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Stay in the loop" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "First access to new drops" },
    { "type": "text", "id": "text", "label": "Text", "default": "Join the list for early access to limited runs and private sample sales." },
    {
      "type": "select", "id": "color_scheme", "label": "Color scheme",
      "options": [ { "value": "1", "label": "Light" }, { "value": "2", "label": "Dark" }, { "value": "3", "label": "Brand (olive)" } ],
      "default": "3"
    },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 128, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 128, "step": 4, "unit": "px", "default": 96 }
  ],
  "presets": [ { "name": "Newsletter" } ]
}
{% endschema %}
