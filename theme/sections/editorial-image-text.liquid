<section class="section-padding color-scheme-{{ section.settings.color_scheme }}" style="padding-top:{{ section.settings.padding_top }}px; padding-bottom:{{ section.settings.padding_bottom }}px; background: var(--scheme-{{ section.settings.color_scheme }}-bg); color: var(--scheme-{{ section.settings.color_scheme }}-text);">
  <div class="page-width">
    <div class="editorial {% if section.settings.layout == 'image_right' %}image-right{% endif %} {% if section.settings.asymmetric %}asymmetric{% endif %}">
      <div class="editorial__media" data-animate>
        {%- if section.settings.image -%}
          {{ section.settings.image | image_url: width: 1400 | image_tag: widths: '500, 800, 1100, 1400', sizes: '(min-width: 750px) 50vw, 100vw', loading: 'lazy', alt: section.settings.image.alt }}
        {%- endif -%}
      </div>
      <div class="editorial__content" data-animate>
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'eyebrow' -%}
              <span class="eyebrow" {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
            {%- when 'heading' -%}
              <h2 {{ block.shopify_attributes }}>{{ block.settings.text }}</h2>
            {%- when 'text' -%}
              <div class="rte mt-4" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
            {%- when 'button' -%}
              <a class="btn btn--{{ block.settings.style }} mt-6" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Editorial image + text",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "select", "id": "layout", "label": "Image position",
      "options": [ { "value": "image_left", "label": "Left" }, { "value": "image_right", "label": "Right" } ],
      "default": "image_left"
    },
    { "type": "checkbox", "id": "asymmetric", "label": "Editorial asymmetry (5/7 split)", "default": true },
    {
      "type": "select", "id": "color_scheme", "label": "Color scheme",
      "options": [ { "value": "1", "label": "Light" }, { "value": "2", "label": "Dark" }, { "value": "3", "label": "Brand (olive)" } ],
      "default": "1"
    },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 128, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 128, "step": 4, "unit": "px", "default": 96 }
  ],
  "blocks": [
    { "type": "eyebrow", "name": "Eyebrow", "limit": 1, "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "Our craft" } ] },
    { "type": "heading", "name": "Heading", "limit": 1, "settings": [ { "type": "text", "id": "text", "label": "Heading", "default": "Made to be kept, not replaced" } ] },
    { "type": "text", "name": "Text", "settings": [ { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Every piece is cut from mill-woven cloth in small batches and finished by hand in our Lisbon atelier. We measure success in how a jacket looks after ten years, not ten washes.</p>" } ] },
    {
      "type": "button", "name": "Button", "limit": 1,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Our story" },
        { "type": "url", "id": "link", "label": "Link" },
        {
          "type": "select", "id": "style", "label": "Style",
          "options": [ { "value": "primary", "label": "Primary" }, { "value": "ghost", "label": "Ghost" } ],
          "default": "ghost"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Editorial image + text",
      "blocks": [ { "type": "eyebrow" }, { "type": "heading" }, { "type": "text" }, { "type": "button" } ]
    }
  ]
}
{% endschema %}
