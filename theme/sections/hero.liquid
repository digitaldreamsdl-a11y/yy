<section class="hero {% if section.settings.height == 'full' %}hero--full{% endif %} {% if section.settings.text_color == 'light' %}hero--on-dark{% endif %}">
  <div class="hero__media">
    {%- if section.settings.image -%}
      {{ section.settings.image | image_url: width: 2000 | image_tag:
          widths: '750, 1100, 1500, 2000',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high',
          alt: section.settings.image.alt | default: section.settings.heading }}
    {%- else -%}
      <div style="width:100%;height:100%;background:var(--scheme-3-bg);"></div>
    {%- endif -%}
    {%- if section.settings.show_scrim -%}<div class="hero__scrim"></div>{%- endif -%}
  </div>

  <div class="page-width">
    <div class="hero__content {% if section.settings.alignment == 'center' %}align-center{% endif %}">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'eyebrow' -%}
            <p class="eyebrow hero__eyebrow" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
          {%- when 'heading' -%}
            <h1 class="display hero__heading" {{ block.shopify_attributes }} data-animate>{{ block.settings.text }}</h1>
          {%- when 'text' -%}
            <p class="hero__body" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
          {%- when 'buttons' -%}
            <div class="hero__actions" {{ block.shopify_attributes }}>
              {%- if block.settings.primary_label != blank -%}
                <a href="{{ block.settings.primary_link }}" class="btn btn--primary">{{ block.settings.primary_label }}</a>
              {%- endif -%}
              {%- if block.settings.secondary_label != blank -%}
                <a href="{{ block.settings.secondary_link }}" class="btn btn--ghost">{{ block.settings.secondary_label }}</a>
              {%- endif -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero banner",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    {
      "type": "select", "id": "height", "label": "Height",
      "options": [ { "value": "standard", "label": "Standard" }, { "value": "full", "label": "Full screen" } ],
      "default": "full"
    },
    {
      "type": "select", "id": "alignment", "label": "Content alignment",
      "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" } ],
      "default": "left"
    },
    {
      "type": "select", "id": "text_color", "label": "Text color",
      "options": [ { "value": "light", "label": "Light (for dark images)" }, { "value": "dark", "label": "Dark" } ],
      "default": "light"
    },
    { "type": "checkbox", "id": "show_scrim", "label": "Darken image for legibility", "default": true }
  ],
  "blocks": [
    { "type": "eyebrow", "name": "Eyebrow", "limit": 1, "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "Autumn / Winter" } ] },
    { "type": "heading", "name": "Heading", "limit": 1, "settings": [ { "type": "text", "id": "text", "label": "Heading", "default": "Tailoring for the way you actually live" } ] },
    { "type": "text", "name": "Body text", "limit": 1, "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "Cut in small batches from mill-woven cloth. Built to hold a decade of wear, not a season." } ] },
    {
      "type": "buttons", "name": "Buttons", "limit": 1,
      "settings": [
        { "type": "text", "id": "primary_label", "label": "Primary button label", "default": "Shop the collection" },
        { "type": "url", "id": "primary_link", "label": "Primary button link" },
        { "type": "text", "id": "secondary_label", "label": "Secondary button label", "default": "Our story" },
        { "type": "url", "id": "secondary_link", "label": "Secondary button link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero banner",
      "blocks": [
        { "type": "eyebrow" },
        { "type": "heading" },
        { "type": "text" },
        { "type": "buttons" }
      ]
    }
  ]
}
{% endschema %}
