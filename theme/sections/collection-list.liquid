<section class="section-padding color-scheme-1" style="padding-top:{{ section.settings.padding_top }}px; padding-bottom:{{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="h2 text-center" style="margin-bottom: var(--space-8);">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <div class="grid grid--3">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.collection.url | default: '#' }}" class="category-tile" {{ block.shopify_attributes }} data-animate>
          {%- if block.settings.image -%}
            {{ block.settings.image | image_url: width: 900 | image_tag: widths: '450, 700, 900', sizes: '(min-width: 750px) 33vw, 100vw', loading: 'lazy', alt: block.settings.title }}
          {%- elsif block.settings.collection.featured_image -%}
            {{ block.settings.collection.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: block.settings.title }}
          {%- endif -%}
          <div class="category-tile__scrim"></div>
          <div class="category-tile__label">
            <p class="eyebrow">{{ block.settings.subtitle }}</p>
            <p class="h3" style="margin-top:var(--space-1);">{{ block.settings.title }}</p>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shop by category",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 128, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 128, "step": 4, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Image (overrides collection image)" },
        { "type": "text", "id": "subtitle", "label": "Eyebrow", "default": "Tailoring" },
        { "type": "text", "id": "title", "label": "Title", "default": "Suits & Blazers" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Shop by category",
      "blocks": [
        { "type": "category", "settings": { "subtitle": "Tailoring", "title": "Suits & Blazers" } },
        { "type": "category", "settings": { "subtitle": "Everyday", "title": "Shirting" } },
        { "type": "category", "settings": { "subtitle": "Finishing", "title": "Outerwear" } }
      ]
    }
  ]
}
{% endschema %}
