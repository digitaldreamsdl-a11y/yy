<section class="section-padding color-scheme-1" style="padding-top:{{ section.settings.padding_top }}px; padding-bottom:{{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    <div class="flex-between" style="margin-bottom: var(--space-8); align-items:flex-end;">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="h2 mt-2">{{ section.settings.heading }}</h2>
      </div>
      {%- if settings.social_instagram != blank -%}
        <a href="{{ settings.social_instagram }}" class="btn--link hide-mobile">Follow along</a>
      {%- endif -%}
    </div>
    <div class="grid grid--4">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link | default: settings.social_instagram }}" class="category-tile" style="aspect-ratio:1/1;" {{ block.shopify_attributes }} data-animate>
          {%- if block.settings.image -%}
            {{ block.settings.image | image_url: width: 600 | image_tag: widths: '300, 450, 600', sizes: '25vw', loading: 'lazy', alt: 'Customer photo' }}
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "UGC gallery",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Community" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Worn by our customers" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 128, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 128, "step": 4, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "UGC gallery",
      "blocks": [ { "type": "photo" }, { "type": "photo" }, { "type": "photo" }, { "type": "photo" } ]
    }
  ]
}
{% endschema %}
