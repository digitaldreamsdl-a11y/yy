<section class="page-width section-padding">
  <h1 class="h1" style="margin-bottom:var(--space-8);">Your bag</h1>

  {%- if cart.item_count == 0 -%}
    <div class="text-center" style="padding:var(--space-24) 0;">
      <p class="h4">Your bag is empty</p>
      <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary mt-6">Continue shopping</a>
    </div>
  {%- else -%}
    <div class="pdp">
      <div>
        {%- for item in cart.items -%}
          <div class="cart-line" data-cart-line data-key="{{ item.key }}">
            <a href="{{ item.url }}" class="cart-line__img">
              {%- if item.image -%}<img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.image.alt | escape }}" loading="lazy" width="84" height="100">{%- endif -%}
            </a>
            <div class="cart-line__meta">
              <a href="{{ item.url }}" class="cart-line__title">{{ item.product.title }}</a>
              {%- if item.variant.title != 'Default Title' -%}<p class="cart-line__variant">{{ item.variant.title }}</p>{%- endif -%}
              <div class="cart-line__controls">
                <div class="qty-input" data-qty-input data-key="{{ item.key }}">
                  <button type="button" data-qty-decrease aria-label="Decrease quantity">{%- render 'icon-minus' -%}</button>
                  <input type="number" min="0" value="{{ item.quantity }}" aria-label="Quantity" data-qty-value>
                  <button type="button" data-qty-increase aria-label="Increase quantity">{%- render 'icon-plus' -%}</button>
                </div>
                <span class="tabular-nums">{{ item.final_line_price | money }}</span>
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>

      <div>
        <div class="cart-drawer__subtotal">
          <span>Subtotal</span>
          <span class="tabular-nums">{{ cart.total_price | money }}</span>
        </div>
        <p class="field__hint mt-2" style="margin-bottom:var(--space-4);">Taxes and shipping calculated at checkout.</p>
        <form action="{{ routes.cart_url }}" method="post">
          <button type="submit" name="checkout" class="btn btn--accent btn--full">Checkout</button>
        </form>
        <p class="pdp-buy__reassurance mt-4">{%- render 'icon-return' -%} 30-day returns · Free exchanges</p>
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{ "name": "Cart page", "settings": [] }
{% endschema %}
